# Public frontend variables (safe for Vite / browser)
VITE_PAYU_CUSTOM_DONATION_URL=https://u.payu.in/9r1hv1tnAno5
VITE_PAYU_FIXED_1000_URL=https://u.payu.in/PAYUMN/Ird2vjwZHq8Z
VITE_PAYU_FIXED_2000_URL=https://u.payu.in/PAYUMN/RIUiX0nf38b6
# Legacy aliases (still read by client/lib/payments.ts)
# VITE_PAYU_FIXED_DONATION_URL=...  # old ₹1000
# VITE_PAYU_FIXED_500_URL=...       # old ₹500 → now ₹2000 page

# Server-only PayU credentials — NEVER prefix with VITE_
#
# LIVE (often only key + salt):
#   PAYU_KEY=...
#   PAYU_SALT=...
#   PAYU_ENVIRONMENT=production
#   PAYU_PAYMENT_URL=https://secure.payu.in/_payment
#
# TEST (Salt-32bit + Salt-256bit on dashboard):
#   PAYU_KEY=...
#   PAYU_SALT_V1=<Salt - 32 bit>
#   PAYU_SALT_V2=<Salt - 256 bit>
#   PAYU_ENVIRONMENT=test
#   PAYU_PAYMENT_URL=https://test.payu.in/_payment
#
PAYU_KEY=
PAYU_SALT=
PAYU_SALT_V1=
PAYU_SALT_V2=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_PAYMENT_URL=https://test.payu.in/_payment
PAYU_ENVIRONMENT=test
PAYU_MAX_MONTHLY_AMOUNT=15000
PAYU_SUBSCRIPTION_END_YEARS=10

# Site URLs (production: https://myshiksha.org)
FRONTEND_URL=http://localhost:8080
API_URL=http://localhost:8080

PING_MESSAGE=ping
PORT=3000
